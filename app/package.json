{
  "name": "raack-trend-detective",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAACK · Trend Detective — NASA Space Apps Challenge 2026 (Be An Earth System Trend Detective!)",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "node scripts/build-data.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "site": "npm run build && node scripts/copy-site.mjs",
    "dete": "node --env-file-if-exists=dete/.env dete/server.mjs",
    "dete:data": "node dete/exportar_series.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
