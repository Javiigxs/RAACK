# Copia este archivo como dete/.env (NUNCA subas .env al repo: ya está en dete/.gitignore).
# La API key la crea una persona del equipo en platform.kimi.ai → API Keys.
MOONSHOT_API_KEY=pon_aqui_la_key
KIMI_MODEL=kimi-k2.6
PORT=8000
# Por defecto el servidor sirve app/dist (sale de npm run build) y lee dete/series_nl.json y dete/catalogo.md.
# ROOT=../site
# HOST=0.0.0.0   (descomenta para abrirla desde otros dispositivos en la misma red)
