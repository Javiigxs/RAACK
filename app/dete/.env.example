# Copia este archivo como dete/.env (NUNCA subas .env al repo: ya está en dete/.gitignore).
# La API key la crea una persona del equipo en platform.kimi.ai → API Keys. Pégala después del signo =, sin comillas.
MOONSHOT_API_KEY=

# Modelo de Kimi. El diseño del equipo usaba kimi-k2.6, pero Kimi ya no lo da a las cuentas registradas
# desde el 1 de noviembre de 2026 y lo retira a finales de diciembre. La cuenta del equipo solo tiene
# kimi-k3.1-pro y kimi-k3 (comprobado con su clave el 15 de noviembre de 2026); kimi-k3.1-pro es el de
# tarifa más baja de los dos. Al arrancar, el servidor dice en la terminal si la clave funciona y si la
# cuenta tiene este modelo.
KIMI_MODEL=kimi-k3.1-pro
PORT=8000

# Cuánto razona el modelo antes de responder: low, high o max (solo kimi-k3 y kimi-k3.1-pro). El
# razonamiento se cobra como salida: con low, DE-T responde antes y gasta menos. Sin esta línea el
# servidor usa low.
KIMI_REASONING_EFFORT=low

# Otros ajustes opcionales. Quita el # solo del que necesites.
# KIMI_MAX_TOKENS=16000        (tope de cada respuesta, razonamiento incluido; Kimi pide 16000 o más)
# KIMI_THINKING=disabled       (solo kimi-k2.6: apaga el razonamiento)

# Gasto. Cada pregunta dice en la terminal los tokens que gastó. Con el precio por millón de tokens, en
# dólares, estima además lo que costó. El servidor ya trae el de kimi-k3.1-pro (2 de entrada, 0.2 con
# caché y 10 de salida), el de kimi-k3 (3, 0.3 y 15) y el de kimi-k2.6 (0.95, 0.16 y 4). Los dos primeros
# salen de páginas que citan la tarifa de Kimi, no de su tabla oficial: compáralos con tu consola.
# Para otro modelo, o si el precio cambia, quita el # y pon el suyo:
# KIMI_PRECIO_ENTRADA=
# KIMI_PRECIO_CACHE=
# KIMI_PRECIO_SALIDA=

# Por defecto el servidor sirve app/dist (sale de npm run build) y lee sus bases de datos de esta carpeta:
# series_nl.json, paises.json y catalogo.md.
# ROOT=../site
# HOST=0.0.0.0   (descomenta para abrirla desde otros dispositivos en la misma red)
